# --- Database ---------------------------------------------------------
# Leave empty for local dev: an embedded Postgres (PGlite) is used (./data/pglite).
# For Supabase / Vercel: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
DATABASE_URL=

# --- Auth (required on Vercel) -----------------------------------------
# Shared team password for the UI. Empty = no login locally; on Vercel the API refuses to run without it.
APP_PASSWORD=
# Protects /api/cron/recheck. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# --- Integrations (all optional) ---------------------------------------
AHREFS_API_KEY=
AI_BASE_URL=https://api.z.ai/api/paas/v4
AI_API_KEY=
AI_MODEL=glm-4.6
VERIFIER_USER_AGENT=BacklinkVerifyBot/0.1 (+internal QA)
PORT=8787
