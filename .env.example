# --- Database ---------------------------------------------------------
# Leave empty for local dev: an embedded Postgres (PGlite) is used (./data/pglite).
# For Supabase / Vercel: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
DATABASE_URL=

# --- Auth ---------------------------------------------------------------
# Sign-in is invite-only: email + 6-digit code. Always on in production (Vercel); locally set REQUIRE_AUTH=1 to try it.
# Long random string that signs sessions and encrypts the Ahrefs key saved in Settings (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Comma-separated emails that become admins on first sign-in.
ADMIN_EMAILS=karim@appscrip.co
# Protects /api/cron/recheck. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
# Emails the sign-in codes (https://resend.com). Without it, codes print to the server console locally; in production use "Sign-in code" on the Users page.
RESEND_API_KEY=
# Needs a domain verified in Resend. The default only delivers to the Resend account owner.
EMAIL_FROM=Backlink Verify <onboarding@resend.dev>
# Optional: link shown in invite emails.
APP_URL=

# --- Integrations (all optional) ---------------------------------------
# Optional: you can paste the key in Settings instead (stored encrypted). A key saved in Settings wins over this.
AHREFS_API_KEY=
# Any OpenAI-compatible API (OpenAI: https://api.openai.com/v1 + gpt-4o). Web search is only sent to z.ai.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o
VERIFIER_USER_AGENT=BacklinkVerifyBot/0.1 (+internal QA)
PORT=8787
